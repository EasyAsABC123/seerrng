FROM node:24.22.1-alpine3.23@sha256:4b00b6d1aa138805aace94cc2482808f2b4f01e5e9c9f8cdc0e217fd70600ef9

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN apk add --no-cache python3 py3-setuptools make g++ gcc libc6-compat
RUN corepack enable

COPY --chown=node:node . /app
WORKDIR /app

RUN mkdir -p /app/node_modules /app/.next "$PNPM_HOME" && \
  chown node:node /app/node_modules /app/.next "$PNPM_HOME"
USER node:node

RUN pnpm install

CMD pnpm dev
